{
  "name": "@amenophis1er/mailcore",
  "version": "0.2.0",
  "description": "Mail and calendar accounts for Node: Exchange (EWS), IMAP/SMTP, JMAP, CalDAV, Google and Microsoft 365, with push, an encrypted cache, drafts and MCP-ready tools. The caller supplies accounts and secrets.",
  "keywords": [
    "email",
    "imap",
    "smtp",
    "jmap",
    "ews",
    "exchange",
    "caldav",
    "google-calendar",
    "microsoft-365",
    "oauth2",
    "mcp"
  ],
  "homepage": "https://github.com/amenophis1er/mailcore#readme",
  "bugs": {
    "url": "https://github.com/amenophis1er/mailcore/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amenophis1er/mailcore.git"
  },
  "license": "MIT",
  "author": "908 Studio <hello@sideora.com>",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./tools": {
      "types": "./tools.d.ts",
      "default": "./src/tools.js"
    }
  },
  "files": [
    "src",
    "index.d.ts",
    "tools.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p test/types"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "fast-xml-parser": "^5.11.2",
    "httpntlm": "^1.8.13",
    "imapflow": "^2.5.9",
    "mailparser": "^3.10.0",
    "node-ical": "^0.27.3",
    "nodemailer": "^10.1.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
