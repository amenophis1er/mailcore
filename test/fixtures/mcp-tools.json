  {
    "name": "awaiting_reply",
    "description": "Threads where the last word is theirs and I never answered: last message inbound, I am in To (or Cc), no message from me after it, within the last `days`. Bulk/automated senders, mailing lists and calendar mail are left out. Each thread: subject, lastMessageId (reply with draft_reply), sender, received, addressed (to|cc|unknown), participants, snippet (200 chars, quotes stripped), askedSomething (question/request heuristic, en+fr), myLastReplyAt, theirsSinceMyLast. Returns { threads, scanned, cursor }: pass `cursor` as `since` on the next sweep to see only threads with newer inbound mail. The judgment of what really needs an answer is yours.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "days": {
          "description": "Look-back window (default 28)",
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "account": {
          "description": "Account name (default: all accounts)",
          "type": "string"
        },
        "limit": {
          "description": "Max threads (default 50)",
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "includeCc": {
          "description": "Include threads where I am only in Cc (default true)",
          "type": "boolean"
        },
        "since": {
          "description": "Cursor from a previous sweep: only threads whose last inbound message is newer",
          "type": "string"
        }
      }
    },
    "execution": {
      "taskSupport": "forbidden"
    }
