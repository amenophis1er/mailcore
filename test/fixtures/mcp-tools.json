  {
    "name": "search_mail",
    "description": "Search a mail folder. sender/subject/to are substrings; text searches subject AND body; hasAttachments filters to mail with files. Inbox queries are served from the local encrypted cache when the daemon is running (live: true forces the server). Returns { items, cursor? }: when `limit` was hit, pass `cursor` as `until` (same filters) to page further back.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "sender": {
          "description": "Substring of sender name or address",
          "type": "string"
        },
        "subject": {
          "description": "Substring of subject",
          "type": "string"
        },
        "text": {
          "description": "Search subject AND body (content-index search)",
          "type": "string"
        },
        "to": {
          "description": "Substring of a To/Cc recipient (name or address)",
          "type": "string"
        },
        "fromMe": {
          "description": "Only mail I sent (sender = my own address)",
          "type": "boolean"
        },
        "since": {
          "description": "ISO date/time: only mail received at or after this (replaces days)",
          "type": "string"
        },
        "until": {
          "description": "ISO date/time: only mail received at or before this — pass a previous result's cursor to page",
          "type": "string"
        },
        "hasAttachments": {
          "description": "Only mail with attachments",
          "type": "boolean"
        },
        "days": {
          "description": "Only mail from the last N days",
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "unread": {
          "description": "Only unread mail",
          "type": "boolean"
        },
        "folder": {
          "description": "Default inbox",
          "type": "string",
          "enum": [
            "inbox",
            "junk",
            "sent",
            "drafts",
            "trash",
            "archive"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "account": {
          "description": "Account name (default: all accounts)",
          "type": "string"
        },
        "live": {
          "description": "Bypass the local cache and query the server",
          "type": "boolean"
        }
      }
    },
    "execution": {
      "taskSupport": "forbidden"
    }
